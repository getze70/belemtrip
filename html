<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Belem Trip - Enlaces</title>
  <!-- Iconos de FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0d1b2a, #1b263b, #415a77);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: #ffffff;
    }

    .container {
      width: 100%;
      max-width: 480px;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 24px;
      padding: 32px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .profile-img {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #ffffff;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      margin-bottom: 16px;
    }

    .title {
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 0.95rem;
      color: #e0e1dd;
      text-align: center;
      margin-bottom: 24px;
      line-height: 1.4;
    }

    .links {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 28px;
    }

    .link-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background: rgba(255, 255, 255, 0.95);
      color: #1b263b;
      text-decoration: none;
      font-weight: 600;
      padding: 14px 20px;
      border-radius: 12px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .link-btn i {
      position: absolute;
      left: 18px;
      font-size: 1.2rem;
    }

    .link-btn:hover {
      background: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    }

    /* Botón destacado opcional (ej. WhatsApp) */
    .link-btn.highlight {
      background: #25d366;
      color: #ffffff;
    }

    .link-btn.highlight:hover {
      background: #20ba5a;
    }

    .socials {
      display: flex;
      gap: 16px;
      margin-top: 4px;
    }

    .social-icon {
      color: #ffffff;
      font-size: 1.4rem;
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .social-icon:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: translateY(-2px);
    }

    footer {
      margin-top: 24px;
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.6);
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Foto de perfil o logotipo -->
    <img src="https://via.placeholder.com/150" alt="Belem Trip Logo" class="profile-img">

    <!-- Nombre y descripción -->
    <h1 class="title">Belem Trip</h1>
    <p class="subtitle">Agencia de Viajes | Experiencias & Destinos inolvidables</p>

    <!-- Lista de Enlaces -->
    <div class="links">
      <a href="https://wa.me/tunumerodetelefono" target="_blank" class="link-btn highlight">
        <i class="fab fa-whatsapp"></i>
        <span>Cotizar por WhatsApp</span>
      </a>

      <a href="#" target="_blank" class="link-btn">
        <i class="fas fa-plane-departure"></i>
        <span>Paquetes Turísticos</span>
      </a>

      <a href="#" target="_blank" class="link-btn">
        <i class="fas fa-hotel"></i>
        <span>Hoteles y Hospedaje</span>
      </a>

      <a href="#" target="_blank" class="link-btn">
        <i class="fas fa-globe"></i>
        <span>Sitio Web Oficial</span>
      </a>

      <a href="#" target="_blank" class="link-btn">
        <i class="fas fa-map-marked-alt"></i>
        <span>Ubicación de Oficina</span>
      </a>
    </div>

    <!-- Redes Sociales -->
    <div class="socials">
      <a href="#" target="_blank" class="social-icon" aria-label="Instagram">
        <i class="fab fa-instagram"></i>
      </a>
      <a href="#" target="_blank" class="social-icon" aria-label="Facebook">
        <i class="fab fa-facebook-f"></i>
      </a>
      <a href="#" target="_blank" class="social-icon" aria-label="TikTok">
        <i class="fab fa-tiktok"></i>
      </a>
      <a href="mailto:contacto@belemtrip.com" class="social-icon" aria-label="Correo">
        <i class="fas fa-envelope"></i>
      </a>
    </div>

    <footer>
      © Belem Trip
    </footer>
  </div>

</body>
</html>
